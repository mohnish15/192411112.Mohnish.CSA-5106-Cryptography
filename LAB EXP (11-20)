#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define SIZE 26

typedef struct
{
    char letter;
    int freq;
} LetterFreq;

void sortFrequency(LetterFreq arr[])
{
    int i,j;
    LetterFreq temp;

    for(i=0;i<SIZE-1;i++)
    {
        for(j=i+1;j<SIZE;j++)
        {
            if(arr[j].freq > arr[i].freq)
            {
                temp=arr[i];
                arr[i]=arr[j];
                arr[j]=temp;
            }
        }
    }
}

int main()
{
    char cipher[500];
    int count[26]={0};
    LetterFreq freq[26];
    char english[]="ETAOINSHRDLCUMWFGYPBVKJXQZ";
    char map[26];
    int i;

    printf("Enter Ciphertext:\n");
    fgets(cipher,sizeof(cipher),stdin);

    for(i=0;cipher[i]!='\0';i++)
    {
        if(isalpha(cipher[i]))
        {
            count[toupper(cipher[i])-'A']++;
        }
    }

    for(i=0;i<26;i++)
    {
        freq[i].letter='A'+i;
        freq[i].freq=count[i];
    }

    sortFrequency(freq);

    for(i=0;i<26;i++)
    {
        map[freq[i].letter-'A']=english[i];
    }

    printf("\nEstimated Plaintext:\n\n");

    for(i=0;cipher[i]!='\0';i++)
    {
        if(isalpha(cipher[i]))
            printf("%c",map[toupper(cipher[i])-'A']);
        else
            printf("%c",cipher[i]);
    }

    printf("\n");

    return 0;
}


