#include <stdio.h>
#include <string.h>

#define SIZE 8

void xorBlock(char a[], char b[], char result[])
{
    for(int i = 0; i < SIZE; i++)
        result[i] = a[i] ^ b[i];
}

int main()
{
    char plaintext[100];
    char iv[SIZE + 1];
    char previous[SIZE];
    char block[SIZE];
    char cipher[SIZE];

    printf("Enter plaintext (multiple of 8 characters): ");
    scanf("%s", plaintext);

    printf("Enter 8-character IV: ");
    scanf("%8s", iv);

    memcpy(previous, iv, SIZE);

    printf("\nCipher Blocks (CBC Demonstration):\n");

    int len = strlen(plaintext);

    for(int i = 0; i < len; i += SIZE)
    {
        memcpy(block, plaintext + i, SIZE);

        xorBlock(block, previous, cipher);

        printf("Block %d : ", (i / SIZE) + 1);

        for(int j = 0; j < SIZE; j++)
            printf("%02X ", (unsigned char)cipher[j]);

        printf("\n");

        memcpy(previous, cipher, SIZE);
    }

    return 0;
}


