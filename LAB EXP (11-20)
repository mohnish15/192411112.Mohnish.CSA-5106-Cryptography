#include <stdio.h>
#include <string.h>
#include <ctype.h>

int modInverse(int a, int m)
{
    a = a % m;
    for (int x = 1; x < m; x++)
        if ((a * x) % m == 1)
            return x;
    return -1;
}

void encrypt(char text[])
{
    int key[2][2] = {{9,4},{5,7}};
    int len = strlen(text);

    if(len % 2 != 0)
    {
        text[len] = 'x';
        text[len+1] = '\0';
        len++;
    }

    printf("\nCiphertext : ");

    for(int i=0;i<len;i+=2)
    {
        int a = text[i]-'a';
        int b = text[i+1]-'a';

        int c1 = (key[0][0]*a + key[0][1]*b)%26;
        int c2 = (key[1][0]*a + key[1][1]*b)%26;

        printf("%c%c", c1+'A', c2+'A');
    }
}

void decrypt(char text[])
{
    int key[2][2]={{9,4},{5,7}};

    int det = (key[0][0]*key[1][1]-key[0][1]*key[1][0])%26;
    if(det<0) det+=26;

    int invDet = modInverse(det,26);

    int inv[2][2];

    inv[0][0]=( key[1][1]*invDet)%26;
    inv[0][1]=((-key[0][1]+26)*invDet)%26;
    inv[1][0]=((-key[1][0]+26)*invDet)%26;
    inv[1][1]=( key[0][0]*invDet)%26;

    int len=strlen(text);

    printf("\nRecovered Plaintext : ");

    for(int i=0;i<len;i+=2)
    {
        int a=toupper(text[i])-'A';
        int b=toupper(text[i+1])-'A';

        int p1=(inv[0][0]*a+inv[0][1]*b)%26;
        int p2=(inv[1][0]*a+inv[1][1]*b)%26;

        printf("%c%c",p1+'a',p2+'a');
    }
}

int main()
{
    char plain[200];

    printf("Enter plaintext (lowercase without spaces): ");
    scanf("%s",plain);

    encrypt(plain);

    char cipher[200];
    printf("\n\nEnter ciphertext to decrypt: ");
    scanf("%s",cipher);

    decrypt(cipher);

    return 0;
}


