#include <stdio.h>

int main()
{
    int blocks, errorBlock;

    printf("Enter total number of plaintext blocks: ");
    scanf("%d", &blocks);

    printf("Enter ciphertext block containing transmission error: ");
    scanf("%d", &errorBlock);

    printf("\n===== ECB MODE =====\n");
    printf("Affected Plaintext Block:\n");
    printf("P%d only\n", errorBlock);

    printf("\n===== CBC MODE =====\n");

    if(errorBlock < blocks)
    {
        printf("Affected Plaintext Blocks:\n");
        printf("P%d and P%d\n", errorBlock, errorBlock + 1);
    }
    else
    {
        printf("Affected Plaintext Block:\n");
        printf("P%d only (last block)\n", errorBlock);
    }

    printf("\nExplanation:\n");
    printf("ECB: Error affects only one plaintext block.\n");
    printf("CBC: Error affects the current block and the next plaintext block.\n");

    return 0;
}


