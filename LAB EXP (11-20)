int modInverse(int a, int m)
{
    a = (a % m + m) % m;
    for (int x = 1; x < m; x++)
    {
        if ((a * x) % m == 1)
            return x;
    }
    return -1;
}

int main()
{
    int P[2][2], C[2][2];
    int Pinv[2][2], K[2][2];

    printf("Enter Plaintext Matrix (2x2):\n");
    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++)
            scanf("%d",&P[i][j]);

    printf("Enter Ciphertext Matrix (2x2):\n");
    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++)
            scanf("%d",&C[i][j]);

    int det = P[0][0]*P[1][1] - P[0][1]*P[1][0];
    det = (det % 26 + 26) % 26;

    int invDet = modInverse(det,26);

    if(invDet==-1)
    {
        printf("Plaintext matrix is not invertible.\n");
        return 0;
    }

    Pinv[0][0] = ( P[1][1]*invDet)%26;
    Pinv[0][1] = ((-P[0][1]+26)*invDet)%26;
    Pinv[1][0] = ((-P[1][0]+26)*invDet)%26;
    Pinv[1][1] = ( P[0][0]*invDet)%26;

    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
        {
            K[i][j]=0;
            for(int k=0;k<2;k++)
                K[i][j]+=C[i][k]*Pinv[k][j];

            K[i][j]%=26;
        }
    }

    printf("\nRecovered Key Matrix:\n");

    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
            printf("%4d",K[i][j]);
        printf("\n");
    }

    return 0;
}

