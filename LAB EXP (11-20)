#include <stdio.h>
#include <string.h>

int main()
{
    char key56[57];
    char left[29], right[29];
    char subkey[49];
    int i;

    printf("Enter a 56-bit binary key:\n");
    scanf("%56s", key56);

    /* Split into two 28-bit halves */
    strncpy(left, key56, 28);
    left[28] = '\0';

    strncpy(right, key56 + 28, 28);
    right[28] = '\0';

    /* First 24 bits from left half */
    for(i = 0; i < 24; i++)
        subkey[i] = left[i];

    /* Next 24 bits from right half */
    for(i = 0; i < 24; i++)
        subkey[i + 24] = right[i];

    subkey[48] = '\0';

    printf("\nLeft Half (28 bits):\n%s\n", left);

    printf("\nRight Half (28 bits):\n%s\n", right);

    printf("\nFirst 24 bits from Left:\n");
    for(i = 0; i < 24; i++)
        printf("%c", left[i]);

    printf("\n\nSecond 24 bits from Right:\n");
    for(i = 0; i < 24; i++)
        printf("%c", right[i]);

    printf("\n\nGenerated 48-bit Subkey:\n%s\n", subkey);

    return 0;
}

