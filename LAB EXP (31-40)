    printf("\n\nCiphertext: %s\n", ciphertext);

    printf("\nRecovered Plaintext: ");

    for(int i = 0; i < len; i++)
    {
        char ch=((ciphertext[i]-'A'-key[i]+26)%26)+'A';
        printf("%c", ch);
    }

    printf("\n");

    return 0;
}



