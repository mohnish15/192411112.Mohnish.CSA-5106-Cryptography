#include <stdio.h>
#include <string.h>

int modInverse(int a)
{
    for(int i=1;i<26;i++)
        if((a*i)%26==1)
            return i;

    return -1;
}

int main()
{
    char plaintext[100];
    char ciphertext[100];
    char recovered[100];

    int a,b;

    printf("Enter Plaintext (uppercase): ");
    scanf("%s",plaintext);

    printf("Enter a and b: ");
    scanf("%d%d",&a,&b);

    if(modInverse(a)==-1)
    {
        printf("Invalid value of a.\n");
        return 0;
    }

    int inv=modInverse(a);

    int len=strlen(plaintext);

    for(int i=0;i<len;i++)
        ciphertext[i]=((a*(plaintext[i]-'A')+b)%26)+'A';

    ciphertext[len]='\0';

    for(int i=0;i<len;i++)
        recovered[i]=((inv*((ciphertext[i]-'A')-b+26))%26)+'A';

    recovered[len]='\0';

    printf("\nCiphertext : %s\n",ciphertext);
    printf("Recovered  : %s\n",recovered);

    return 0;
}

