#include <stdio.h>
#include <string.h>

#define BLOCK_SIZE 8

void padMessage(char msg[])
{
    int len = strlen(msg);

    msg[len] = '1';
    len++;

    while(len % BLOCK_SIZE != 0)
    {
        msg[len] = '0';
        len++;
    }

    msg[len] = '\0';
}

int main()
{
    char plaintext[100];

    printf("Enter binary plaintext: ");
    scanf("%s", plaintext);

    padMessage(plaintext);

    printf("\nPadded Plaintext: %s\n", plaintext);

    printf("\nECB Mode Blocks:\n");
    for(int i = 0; i < strlen(plaintext); i += BLOCK_SIZE)
    {
        for(int j = 0; j < BLOCK_SIZE; j++)
            printf("%c", plaintext[i+j]);
        printf("\n");
    }

    printf("\nCBC Mode: Each plaintext block is XORed with previous ciphertext block before encryption.\n");
    printf("CFB Mode: Previous ciphertext is encrypted and XORed with plaintext.\n");

    return 0;
}

