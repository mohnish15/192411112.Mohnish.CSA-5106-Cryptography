#include <stdio.h>
#include <string.h>

void leftShift(unsigned char in[], unsigned char out[], int size)
{
    int i;
    unsigned char overflow = 0;

    for(i = size - 1; i >= 0; i--)
    {
        out[i] = (in[i] << 1) | overflow;
        overflow = (in[i] & 0x80) ? 1 : 0;
    }
}

int main()
{
    unsigned char L[16] = {0};
    unsigned char K1[16], K2[16];

    leftShift(L, K1, 16);
    leftShift(K1, K2, 16);

    printf("CMAC Subkeys Generated Successfully.\n");

    return 0;
}

