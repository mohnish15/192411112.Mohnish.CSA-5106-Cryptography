    srand(time(NULL));

    printf("\nRandom Key:\n");

    for(int i = 0; i < len; i++)
    {
        key[i] = rand() % 26;
        printf("%d ", key[i]);

        ciphertext[i] = ((plaintext[i]-'A'+key[i])%26)+'A';
