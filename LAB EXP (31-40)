#include <stdio.h>

unsigned long encrypt(unsigned long plaintext, unsigned long key)
{
    return plaintext ^ key;
}

unsigned long decrypt(unsigned long ciphertext, unsigned long key)
{
    return ciphertext ^ key;
}

int main()
{
    unsigned long plaintext = 12345678;
    unsigned long key = 9876543;

    unsigned long ciphertext = encrypt(plaintext, key);
    unsigned long recovered = decrypt(ciphertext, key);

    printf("Plaintext  : %lu\n", plaintext);
    printf("Ciphertext : %lu\n", ciphertext);
    printf("Recovered  : %lu\n", recovered);

    return 0;
}

