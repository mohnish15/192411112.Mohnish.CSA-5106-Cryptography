#include <stdio.h>
#include <math.h>

int power(int a,int b,int mod)
{
    int result=1;

    while(b>0)
    {
        result=(result*a)%mod;
        b--;
    }

    return result;
}

int main()
{
    int q=23;
    int a=5;

    int x=6;
    int y=15;

    int A=power(a,x,q);
    int B=power(a,y,q);

    int key1=power(B,x,q);
    int key2=power(A,y,q);

    printf("Shared Key=%d\n",key1);

    return 0;
}

