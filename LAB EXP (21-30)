#include <stdio.h>

int encrypt(int p,int key)
{
    return (p+key)%256;
}

int decrypt(int c,int key)
{
    return (c-key+256)%256;
}

int main()
{
    int plaintext[4]={1,2,3,4};
    int cipher[4];
    int recover[4];

    int key=7;
    int iv=170;

    int prev=iv;

    printf("Encryption:\n");

    for(int i=0;i<4;i++)
    {
        cipher[i]=encrypt(plaintext[i]^prev,key);
        prev=cipher[i];
        printf("%d ",cipher[i]);
    }

    prev=iv;

    printf("\nDecryption:\n");

    for(int i=0;i<4;i++)
    {
        recover[i]=decrypt(cipher[i],key)^prev;
        prev=cipher[i];
        printf("%d ",recover[i]);
    }

    return 0;
}

