#include <stdio.h>

int gcd(int a,int b)
{
    while(b)
    {
        int t=a%b;
        a=b;
        b=t;
    }
    return a;
}

int main()
{
    int n=3599;
    int plaintext=61;

    int factor=gcd(plaintext,n);

    printf("Common Factor = %d\n",factor);

    return 0;
}

