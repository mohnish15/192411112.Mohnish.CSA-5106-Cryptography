#include <stdio.h>
#include <string.h>

#define BLOCK 8

void xorBlock(char a[], char b[], char out[])
{
    for(int i=0;i<BLOCK;i++)
        out[i]=(a[i]==b[i])?'0':'1';
    out[BLOCK]='\0';
}

int main()
{
    char plaintext[100];

    printf("Enter binary plaintext: ");
    scanf("%s",plaintext);

    int len=strlen(plaintext);

    // Padding (1 followed by 0's)
    plaintext[len]='1';
    len++;

    while(len%BLOCK!=0)
    {
        plaintext[len]='0';
        len++;
    }

    plaintext[len]='\0';

    printf("\nPadded Plaintext : %s\n",plaintext);

    printf("\nECB Mode:\n");
    for(int i=0;i<len;i+=BLOCK)
    {
        printf("Block %d : ",i/BLOCK+1);
        for(int j=0;j<BLOCK;j++)
            printf("%c",plaintext[i+j]);
        printf("\n");
    }

    printf("\nCBC and CFB modes use XOR with previous ciphertext/IV before encryption.\n");

    return 0;
}


