#include <stdio.h>

int gcdExtended(int a,int b,int *x,int *y)
{
    if(a==0)
    {
        *x=0;
        *y=1;
        return b;
    }

    int x1,y1;

    int gcd=gcdExtended(b%a,a,&x1,&y1);

    *x=y1-(b/a)*x1;
    *y=x1;

    return gcd;
}

int main()
{
    int e=31;
    int phi=3480;

    int x,y;

    gcdExtended(e,phi,&x,&y);

    int d=(x%phi+phi)%phi;

    printf("Private Key d = %d\n",d);

    return 0;
}

